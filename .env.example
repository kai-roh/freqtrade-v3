# Binance API (Futures trading permission only, withdrawals disabled)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Freqtrade Web UI
FREQTRADE_USERNAME=v3_shadow
FREQTRADE_PASSWORD=change_this_strong_password
JWT_SECRET=run_openssl_rand_hex_32_and_paste_here

# External V3 operations reports (Freqtrade's built-in Telegram bot stays disabled).
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
REPORT_TZ=Asia/Seoul

# Strategy supplied by the v3 strategy layer.
FREQTRADE_STRATEGY=V3ShadowStrategy

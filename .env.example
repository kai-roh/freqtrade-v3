# Binance API (Futures trading permission only, withdrawals disabled)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Phase 1 uses separate Binance Demo credentials. Never place live credentials
# in the Phase 1 execution environment.
BINANCE_DEMO_API_KEY=your_demo_api_key_here
BINANCE_DEMO_API_SECRET=your_demo_api_secret_here
PHASE1_POSTGRES_PASSWORD=change_this_separate_database_password
# Set after a verified local/CI build, for example image@sha256:<64 hex>.
PHASE1_EXECUTION_IMAGE=freqtrade-v3-phase1-execution@sha256:replace_with_verified_digest

# Freqtrade Web UI
FREQTRADE_USERNAME=v3_shadow
FREQTRADE_PASSWORD=change_this_strong_password
JWT_SECRET=run_openssl_rand_hex_32_and_paste_here

# External V3 operations reports (Freqtrade's built-in Telegram bot stays disabled).
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
REPORT_TZ=Asia/Seoul
